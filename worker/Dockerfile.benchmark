FROM docker.io/nvidia/cuda:11.8.0-base-ubuntu22.04

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    DEBIAN_FRONTEND=noninteractive \
    PATH="/app/.venv/bin:/uv/bin:${PATH}" \
    HF_HOME="/app/.cache/huggingface" \
    XDG_CACHE_HOME="/app/.cache" \
    UV_HTTP_TIMEOUT=120

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-venv \
    ffmpeg \
    git \
    ca-certificates \
    tini \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.9.3 /uv /uv/bin/uv

WORKDIR /app

RUN useradd -m -u 10001 appuser && mkdir -p /app/.cache /app/audio_dataset && chown appuser:appuser /app/.cache /app/audio_dataset

# Copy only dependency metadata first for better cache hit rate
COPY --chown=appuser:appuser pyproject.toml uv.lock README.md ./
COPY --chown=appuser:appuser benchmark/requirements.txt ./benchmark/requirements.txt

# Install worker runtime deps from lockfile, then install WhisperX explicitly.
# The historical lockfile can omit the Git dependency even though pyproject.toml declares it.
RUN uv sync --frozen --no-dev --no-install-project && \
        uv pip install --python /app/.venv/bin/python --no-cache \
            "whisperx @ git+https://github.com/m-bain/whisperX.git" && \
        uv pip install --python /app/.venv/bin/python --no-cache -r benchmark/requirements.txt

# Copy source code (datasets are intentionally excluded to keep image small)
COPY --chown=appuser:appuser worker ./worker
COPY --chown=appuser:appuser benchmark ./benchmark

# Optional model preloading for benchmarks
ARG PRELOAD_MODELS=""
ARG PRELOAD_ALIGN_LANGS=""
ARG PRELOAD_DIARIZATION="false"
ARG HUGGING_FACE_TOKEN=""

USER appuser

RUN python -c "import whisperx; print('WhisperX available:', whisperx.__file__)"

RUN if [ -n "${PRELOAD_MODELS}" ] || [ -n "${PRELOAD_ALIGN_LANGS}" ] || [ "${PRELOAD_DIARIZATION}" = "true" ]; then \
      echo "Preloading WhisperX artifacts into image cache..." && \
      python3 -c "import os, whisperx; from whisperx.diarize import DiarizationPipeline; device='cpu'; models=[m.strip() for m in os.getenv('PRELOAD_MODELS','').split(',') if m.strip()]; langs=[l.strip() for l in os.getenv('PRELOAD_ALIGN_LANGS','').split(',') if l.strip()]; preload_d=os.getenv('PRELOAD_DIARIZATION','false').lower()=='true'; token=os.getenv('HUGGING_FACE_TOKEN',''); [whisperx.load_model(m, device, compute_type='int8') for m in models]; [whisperx.load_align_model(language_code=l, device=device) for l in langs]; DiarizationPipeline(token=token, device=device) if preload_d and token else None; print('Model preload complete')"; \
    else \
      echo "Skipping model preloading (runtime lazy download enabled)."; \
    fi

ENTRYPOINT ["tini", "--"]
CMD ["sh", "-c", "python3 benchmark/benchmark.py && streamlit run benchmark/dashboard.py --server.port 8501 --server.address 0.0.0.0 --server.enableCORS false --server.enableXsrfProtection false"]
